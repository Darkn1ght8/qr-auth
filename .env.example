# Copy to .env and adjust.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.ngrok-free.app
# Required when the site is opened through ngrok/HTTPS, e.g. https://abcd-1234.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app
# Trust X-Forwarded-Proto/For from ngrok or a reverse proxy
DJANGO_TRUST_PROXY=True

# Separate key for QR HMAC signatures (defaults to DJANGO_SECRET_KEY)
QR_HMAC_KEY=another-long-random-string
# Optional: force the host encoded into QR codes (e.g. your ngrok URL)
QR_PUBLIC_BASE_URL=
QR_TTL_SECONDS=60
QR_REFRESH_SECONDS=30
QR_EXCHANGE_TTL_SECONDS=30

# Optional Redis for Channels + cache (multi-process). Empty = in-memory fallback.
REDIS_URL=
